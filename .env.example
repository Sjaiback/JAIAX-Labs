# Producción: NEXT_PUBLIC_SITE_URL=https://jaiax.com y NEXT_PUBLIC_INDEXABLE=true.
# En desarrollo se conserva localhost y noindex.
NEXT_PUBLIC_INDEXABLE=false
# Opcional: token público de verificación de Search Console, una vez obtenido.
