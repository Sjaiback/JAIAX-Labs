NEXT_PUBLIC_SITE_URL=http://localhost:3107
# Activar solo cuando el dominio definitivo esté bajo tu control, publicado y revisado.
# jaiax.com es un dominio previsto, todavía no confirmado.
NEXT_PUBLIC_INDEXABLE=false
# Opcional: token público de verificación de Search Console, una vez obtenido.
